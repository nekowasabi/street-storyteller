---
title: "MCP stdio session"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: open
    lg1: done
  }
  class lg0 blue
  class lg1 teal
  s0: Waiting with stdin open
  s1: Ended because stdin closed
  s2: Ended because the caller cancelled
  s3: Both messages are buffered
  s4: One message is still buffered
  s5: Stdin closed with both messages left
  s6: Answered and still listening
  s7: Stdin closed with one message left
  s8: Finishing after stdin closed
  [*] --> s0
  s0 --> s1: client closes stdin
  s0 --> s2: caller cancels
  s0 --> s3: client writes initialize and tools/call together
  s3 --> s4: server reads one message and answers
  s3 --> s5: client closes stdin
  s3 --> s2: caller cancels
  s4 --> s6: server reads one message and answers
  s4 --> s7: client closes stdin
  s4 --> s2: caller cancels
  s5 --> s7: server reads one message and answers
  s5 --> s2: caller cancels
  s6 --> s1: client closes stdin
  s6 --> s2: caller cancels
  s7 --> s8: server reads one message and answers
  s7 --> s2: caller cancels
  s8 --> s1: buffer is empty and the session ends
  s8 --> s2: caller cancels
  class s0 blue
  class s1 teal
  class s2 teal
  class s3 blue
  class s4 blue
  class s5 blue
  class s6 blue
