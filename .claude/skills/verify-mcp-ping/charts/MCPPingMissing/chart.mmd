---
title: "MCP ping over stdio"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: open
    lg1: done
    lg2: broken
    lg3: Breaks EveryPingAnsweredBeforeExit or PingNeverRejected
    lg4: Breaks PingNeverRejected in some cases
    lg5: Path to the EveryPingAnsweredBeforeExit or PingNeverRejected bug
  }
  class lg0 blue
  class lg1 teal
  class lg2 orange
  class lg3 breaks
  class lg4 mayBreak
  class lg5 bugPath
  s0: Not initialized yet, stdin open
  s1: Ended because the caller cancelled
  s2: Not initialized yet, stdin closed
  s3: Ended after stdin closed
  s4: A ping got an error, session still up
  s5: Initialized, stdin open
  s6: Initialized, stdin closed
  s7: Ended with a ping unanswered
  [*] --> s0
  s0 --> s1: caller cancels
  s0 --> s2: client closes stdin
  s0 --> s0: client sends ping
  s2 --> s1: caller cancels
  s2 --> s3: every line is read and stdin hits EOF
  s0 --> s5: server answers initialize
  s0 --> s4: server answers ping
  s2 --> s6: server answers initialize
  s2 --> s4: server answers ping
  s4 --> s1: caller cancels
  s5 --> s1: caller cancels
  s5 --> s6: client closes stdin
  s4 --> s7: every line is read and stdin hits EOF
  s6 --> s1: caller cancels
  s6 --> s3: every line is read and stdin hits EOF
  s5 --> s4: server answers ping
  s6 --> s4: server answers ping
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
